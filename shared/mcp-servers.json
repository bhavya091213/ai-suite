{
  "_comment": "SOURCE OF TRUTH for MCP servers shared by Claude Code and Codex CLI. Edit this file, then run ~/.agents/bin/sync-agents to render it into ~/.codex/config.toml ([mcp_servers.*] tables) and Claude Code's user-scope MCP list (via the `claude mcp` CLI). Never hand-edit ~/.claude.json - Claude Code rewrites it. Each entry: type stdio|http, command/args/env for stdio, url for http, and targets listing which tools should get it. Set \"enabled\": false on an entry to keep it listed but skip it when syncing (status shows it as disabled).",
  "servers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "targets": ["claude", "codex"]
    },
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp",
      "targets": ["claude", "codex"]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "targets": ["claude", "codex"],
      "enabled": false
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "targets": ["claude", "codex"]
    },
    "headroom": {
      "type": "stdio",
      "command": "$HOME/.local/bin/headroom",
      "args": ["mcp", "serve"],
      "targets": ["claude", "codex"]
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "targets": ["claude", "codex"]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--extension"],
      "targets": ["claude", "codex"]
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "targets": ["claude", "codex"]
    },
    "trello": {
      "type": "stdio",
      "command": "$HOME/.codex/scripts/codex-mcp-trello",
      "args": [],
      "targets": ["claude", "codex"]
    }
  }
}
